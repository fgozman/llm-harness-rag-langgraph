# Copy to .env and fill in. .env is read by both the app (pydantic-settings) and docker compose.
# Nested settings use "__", e.g. LLM__GENERATION_MODEL. Non-secret defaults live in config.yaml.

# --- Secrets ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Hardware ---
# mac (default) | gpu | cpu  — selects embedding/reranker models and dtype.
HARDWARE_PROFILE=mac
# auto (cuda > mps > cpu) | cuda | mps | cpu
DEVICE=auto
# Lets unsupported MPS ops fall back to CPU instead of crashing.
PYTORCH_ENABLE_MPS_FALLBACK=1
# Avoids a Rayon thread-pool deadlock between HF tokenizers and Docling during ingestion.
TOKENIZERS_PARALLELISM=false

# --- LLM (optional overrides) ---
# anthropic | openai | ollama. Models default per provider (see config.yaml).
# LLM__PROVIDER=anthropic
# LLM__GENERATION_MODEL=claude-sonnet-5-5
# LLM__CHEAP_MODEL=claude-haiku-5-5
# LLM__OLLAMA_BASE_URL=http://localhost:11434
# LLM__OPENAI_BASE_URL=

# --- Services ---
# Host ports used by docker compose; change if they clash with other local services.
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
PHOENIX_PORT=6006
PHOENIX_GRPC_PORT=4317
# Must match the ports above.
QDRANT__URL=http://localhost:6333
PHOENIX__COLLECTOR_ENDPOINT=http://localhost:6006
# PHOENIX__ENABLED=false

# --- Test corpus (scripts/build_test_corpus.py) ---
# SEC fair-access rules require a contact email in the User-Agent.
CORPUS__SEC_USER_AGENT_EMAIL=
# Optional: raises the GitHub API rate limit for release notes (60/h unauthenticated).
GITHUB_TOKEN=
# Optional: faster Hugging Face model downloads.
HF_TOKEN=
